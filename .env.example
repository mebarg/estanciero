# Copiar a .env. No subir la contraseña al repositorio.
# Para desarrollo sin base de datos: ESTANCIERO_STORAGE=json.
ESTANCIERO_STORAGE=postgres
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=estanciero
PGUSER=estanciero
PGPASSWORD="completar_en_el_servidor"

# También se admite DATABASE_URL en lugar de PGHOST/PGPORT/etc.
# PORT=5187
# ESTANCIERO_MAX_ROOMS=200
